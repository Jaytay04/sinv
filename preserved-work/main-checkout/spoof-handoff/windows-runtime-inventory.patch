+void AddEnumerationFailure(
+    std::vector<DeviceIdentifier>& identifiers,
+    const char* field,
+    const char* class_name,
+    const EnumerationResult& result) {
+    AddUncovered(
+        identifiers,
+        field,
+        "*",
+        class_name,
+        QueryFailureNote(result));
+}
