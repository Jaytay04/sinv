[Version]
Signature="$Windows NT$"
Class=NetService
ClassGuid={4d36e974-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile.ntamd64=client_nic_filter.cat
DriverVer=10/16/2026,1.0.0.0
PnpLockDown=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...16299

[Models.NTamd64.10.0...16299]
%NicFilterDescription%=NicFilter_Install,HypersinvNicAddressFilter

[NicFilter_Install.NT]
Characteristics=0x40000
NetCfgInstanceId="{A21B3B08-65E4-4BD9-A933-10B3D68129CD}"
CopyFiles=NicFilter_CopyFiles
AddReg=NicFilter_Ndi

[NicFilter_Install.NT.Services]
AddService=HypersinvNicAddressFilter,,NicFilter_Service

[NicFilter_Install.NT.Remove.Services]
DelService=HypersinvNicAddressFilter,0x00000200

[NicFilter_Service]
DisplayName=%NicFilterDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\client_nic_filter.sys
LoadOrderGroup=NDIS
Description=%NicFilterDescription%

[NicFilter_Ndi]
HKR,Ndi,Service,,"HypersinvNicAddressFilter"
HKR,Ndi,CoServices,0x00010000,"HypersinvNicAddressFilter"
HKR,Ndi,FilterClass,,custom
HKR,Ndi,FilterType,0x00010001,2
HKR,Ndi,FilterRunType,0x00010001,2
HKR,Ndi\Interfaces,UpperRange,,"noupper"
HKR,Ndi\Interfaces,LowerRange,,"nolower"
HKR,Ndi\Interfaces,FilterMediaTypes,,"ethernet, wan, ppip"

[DestinationDirs]
NicFilter_CopyFiles=13

[NicFilter_CopyFiles]
client_nic_filter.sys

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
client_nic_filter.sys=1

[Strings]
ProviderName="Hypersinv"
NicFilterDescription="Hypersinv current-address NDIS lightweight filter"
DiskName="Hypersinv network filter package"
